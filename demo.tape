# demo.tape — records demo.gif for the README.
# Runs azzx-crypto-stream in --demo mode (simulated data, recording only)
# and walks through all four tabs.
Output demo.gif
Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 700
Set Padding 12
Hide
Type "./azzx-crypto-stream --demo" Enter
Sleep 4s
Type "2" Sleep 5s
Type "3" Sleep 5s
Type "4" Sleep 4s
Type "f" Sleep 3s
Type "1" Sleep 3s
Type "s" Sleep 2s
Type "q" Sleep 1s
Show
